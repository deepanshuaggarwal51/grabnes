#
# Linux platform
# Compiler: Intel
# Parallel mode
# 
#=================================================

#OMPI_ROOT=/share/apps/openmpi-1.4-intel
#OMPI_ROOT=/usr/local/opt/openmpi/1.6.4/intel/12.1/
#OMPI_ROOT=/opt/apps/intel13/mvapich2/1.9/
#OMPI_ROOT=/opt/apps/intel15/mvapich2/2.1/


#F90 = $(OMPI_ROOT)/bin/mpif90
#F90 = mpif90
F90 = mpiifort
F90_SERIAL=ifort
#FCFLAGS = -O3 -DMPI -DDEBUG -qopenmp -DPOINTER_SIZE=8 -g
#FCFLAGS = -O3 -DMPI -DDEBUG -qopenmp -DPOINTER_SIZE=8 -g -xCORE-AVX2 -axMIC-AVX512 -heap-arrays
#FCFLAGS = -O3 -DMPI -DDEBUG -qopenmp -DPOINTER_SIZE=8 -g
#FCFLAGS = -O0 -DMPI -DDEBUG -qopenmp -DPOINTER_SIZE=8 -g -traceback -check all -fp-stack-check -heap-arrays -I_MPI_DEBUG=5 -check pointers
FCFLAGS = -O3 -DMPI -DDEBUG -qopenmp -DPOINTER_SIZE=8 -g -heap-arrays -DTIMER
#
ARFLAGS = rc

EXTRA_LIBS=-liomp5
#SPRNGROOT=/home/rmartinez/builds/sprng4-intel
#INCSPRNG=-I$(SPRNGROOT)/include
#LIBSPRNG=$(SPRNGROOT)/lib/libsprng.a
#LIBMPI=-I/opt/openmpi/include -L/opt/openmpi/lib -lmpi_cxx -lmpi -lopen-rte -lopen-pal -ldl -Wl,--export-dynamic -lnsl -lutil -lm -ldl

INCMKL=-I$(MKLROOT)/include/intel64/lp64 -I$(MKLROOT)/include -L/lib64 -llapack
LIBBLAS = $(MKLROOT)/lib/intel64/libmkl_blas95_lp64.a
LIBLAPACK = $(MKLROOT)/lib/intel64/libmkl_lapack95_lp64.a -Wl,--start-group $(MKLROOT)/lib/intel64/libmkl_sequential.a $(MKLROOT)/lib/intel64/libmkl_intel_lp64.a $(MKLROOT)/lib/intel64/libmkl_core.a -Wl,--end-group -lpthread

INCFLAGS=$(INCMKL) $(INCSPRNG)

LIBS = $(LIBMPI) $(LIBSPRNG)  \
       $(LIBLAPACK) $(LIBBLAS) \
       $(EXTRA_LIBS)

#LIBS = $(LIBLAPACK) $(LIBBLAS) \
#       $(EXTRA_LIBS)
