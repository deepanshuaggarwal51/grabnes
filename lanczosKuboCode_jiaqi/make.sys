#=================================================
#
# Linux platform
# Compiler: Intel
# Parallel mode
#
#=================================================

F90 = mpiifort
F90_SERIAL = ifort
ARFLAGS = rc

EXTRA_LIBS = -liomp5

# Paths and flags
MKLROOT = /opt/intel/oneapi/mkl/latest

# Compiler flags
#FCFLAGS = -O3 -DMPI -DDEBUG -qopenmp -DPOINTER_SIZE=8 -g -heap-arrays -DTIMER
FCFLAGS = -O3 -DMPI -qopenmp -DPOINTER_SIZE=8 -heap-arrays -DTIMER
#FCFLAGS = -O0 -DMPI -DDEBUG -qopenmp -DPOINTER_SIZE=8 -g -traceback -check all -fp-stack-check -heap-arrays -I_MPI_DEBUG=5 -check pointers -DTIMER
EXTRA_LIBS = -liomp5

# Include and library paths
INCMKL = -I$(MKLROOT)/include
#LIBMKL = -L$(MKLROOT)/lib/intel64 -lmkl_intel_lp64 -lmkl_sequential -lmkl_core -lmkl_lapack95_lp64 -lmkl_blas95_lp64 -lpthread -lm -ldl
LIBMKL = -L$(MKLROOT)/lib/intel64 -lmkl_intel_lp64 -lmkl_core -lmkl_intel_thread -lmkl_lapack95_lp64 -lmkl_blas95_lp64 -lpthread -lm -ldl

INCFLAGS = $(INCMKL)
LIBS = $(LIBMKL) $(EXTRA_LIBS) /TGM/Apps/ARPACK_INTEL/libarpack_TGM.a

# Linker flags
LDFLAGS = -Wl,--exclude-libs,libflexiblas.so.3

